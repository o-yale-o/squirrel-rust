// 浮点特殊值（nan/inf/±0）在各标志位下的 MSVC 输出探针
function rt(x) { return x; }
local qnan = rt(0.0) / rt(0.0);
local nqnan = -qnan;
local inf = rt(1.0) / rt(0.0);
local ninf = -inf;
local nzero = rt(-0.0);
print("nan   %f     =[" + format("%f", qnan) + "]\n");
print("nan   %+f    =[" + format("%+f", qnan) + "]\n");
print("nan   % f    =[" + format("% f", qnan) + "]\n");
print("nan   %010f  =[" + format("%010f", qnan) + "]\n");
print("nan   %-10f| =[" + format("%-10f|", qnan) + "]\n");
print("nan   %#f    =[" + format("%#f", qnan) + "]\n");
print("nan   %.0f   =[" + format("%.0f", qnan) + "]\n");
print("nan   %e     =[" + format("%e", qnan) + "]\n");
print("nan   %+e    =[" + format("%+e", qnan) + "]\n");
print("nan   %g     =[" + format("%g", qnan) + "]\n");
print("nan   %+g    =[" + format("%+g", qnan) + "]\n");
print("-nan  %f     =[" + format("%f", nqnan) + "]\n");
print("-nan  %+f    =[" + format("%+f", nqnan) + "]\n");
print("-nan  % f    =[" + format("% f", nqnan) + "]\n");
print("-nan  %010f  =[" + format("%010f", nqnan) + "]\n");
print("-nan  %-10f| =[" + format("%-10f|", nqnan) + "]\n");
print("-nan  %+g    =[" + format("%+g", nqnan) + "]\n");
print("inf   %f     =[" + format("%f", inf) + "]\n");
print("inf   %+f    =[" + format("%+f", inf) + "]\n");
print("inf   % f    =[" + format("% f", inf) + "]\n");
print("inf   %010f  =[" + format("%010f", inf) + "]\n");
print("inf   %-10f| =[" + format("%-10f|", inf) + "]\n");
print("inf   %e     =[" + format("%e", inf) + "]\n");
print("inf   %g     =[" + format("%g", inf) + "]\n");
print("-inf  %f     =[" + format("%f", ninf) + "]\n");
print("-inf  %+f    =[" + format("%+f", ninf) + "]\n");
print("-inf  %010f  =[" + format("%010f", ninf) + "]\n");
print("-0    %f     =[" + format("%f", nzero) + "]\n");
print("-0    %+f    =[" + format("%+f", nzero) + "]\n");
print("-0    % f    =[" + format("% f", nzero) + "]\n");
print("-0    %010f  =[" + format("%010f", nzero) + "]\n");
print("-0    %g     =[" + format("%g", nzero) + "]\n");
print("-0    %+g    =[" + format("%+g", nzero) + "]\n");
print("-0    %.0f   =[" + format("%.0f", nzero) + "]\n");
print("-0    %e     =[" + format("%e", nzero) + "]\n");
print("-0    %#.0f  =[" + format("%#.0f", nzero) + "]\n");
print("one   %#.0f  =[" + format("%#.0f", 1.0) + "]\n");
print("one   %#g    =[" + format("%#g", 1.0) + "]\n");
print("one   %#.1g  =[" + format("%#.1g", 1.0) + "]\n");
print("one   %#.3g  =[" + format("%#.3g", 1.0) + "]\n");
print("one   %#e    =[" + format("%#e", 1.0) + "]\n");
print("one   %#.0e  =[" + format("%#.0e", 1.0) + "]\n");
print("one   %#.0f  =[" + format("%#.0f", 1.0) + "]\n");
print("100   %#g    =[" + format("%#g", 100.0) + "]\n");
print("third %#g    =[" + format("%#g", 1.0/3.0) + "]\n");
print("1e6   %#g    =[" + format("%#g", 1000000.0) + "]\n");
print("zero  %#o    =[" + format("%#o", 0) + "]\n");
print("zero  %#x    =[" + format("%#x", 0) + "]\n");
print("zero  %#.0x  =[" + format("%#.0x", 0) + "]\n");
print("zero  %.0d   =[" + format("%.0d", 0) + "]\n");
print("zero  %.d    =[" + format("%.d", 0) + "]\n");
print("one   %.d    =[" + format("%.d", 1) + "]\n");
print("one   %05.3d =[" + format("%05.3d", 1) + "]\n");
print("one   %-05d  =[" + format("%-05d", 1) + "]\n");
print("one   %+u    =[" + format("%+u", 1) + "]\n");
print("mone  %#x    =[" + format("%#x", -1) + "]\n");
print("one   %08.3x =[" + format("%08.3x", 255) + "]\n");
print("abc   %05s   =[" + format("%05s", "abc") + "]\n");
print("abc   %05c   =[" + format("%05c", 65) + "]\n");
print("abc   %c     =[" + format("%c", 255) + "]\n");
print("abc   %5c    =[" + format("%5c", 65) + "]\n");
print("one   %5.3f  =[" + format("%5.3f", 1.0) + "]\n");
print("one   %+5.3f =[" + format("%+5.3f", 1.0) + "]\n");
print("one   %.99f  =[" + format("%.3f", 1.0) + "]\n");
print("one   %+s    =[" + format("%+s", "a") + "]\n");
print("one   %#s    =[" + format("%#s", "a") + "]\n");
print("one   %0s    =[" + format("%0s", "a") + "]\n");
print("true  %d     =[" + format("%d", true) + "]\n");
print("false %d     =[" + format("%d", false) + "]\n");
print("true  %f     =[" + format("%f", true) + "]\n");
print("f15   %d     =[" + format("%d", 1.5) + "]\n");
print("fn15  %d     =[" + format("%d", -1.5) + "]\n");
print("f25   %x     =[" + format("%x", 2.5) + "]\n");
print("bigf  %d     =[" + format("%d", 1.0e30) + "]\n");
print("null  %d     =[" + format("%d", null) + "]\n");
