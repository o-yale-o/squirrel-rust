s("cassign_add_tbl", function() { local o = { n = 4 }; o.n += 2; return o.n; });
s("cassign_add_arr", function() { local o = [4]; o[0] += 2; return o[0]; });
s("cassign_add_cls", function() { class C { n = 4; } C.n += 2; return C.n; });
s("cassign_add_inst", function() { class C { n = 4; } local o = C(); o.n += 2; return o.n; });
s("cassign_sub_tbl", function() { local o = { n = 4 }; o.n -= 2; return o.n; });
s("cassign_sub_arr", function() { local o = [4]; o[0] -= 2; return o[0]; });
s("cassign_sub_cls", function() { class C { n = 4; } C.n -= 2; return C.n; });
s("cassign_sub_inst", function() { class C { n = 4; } local o = C(); o.n -= 2; return o.n; });
s("cassign_mul_tbl", function() { local o = { n = 4 }; o.n *= 2; return o.n; });
s("cassign_mul_arr", function() { local o = [4]; o[0] *= 2; return o[0]; });
s("cassign_mul_cls", function() { class C { n = 4; } C.n *= 2; return C.n; });
s("cassign_mul_inst", function() { class C { n = 4; } local o = C(); o.n *= 2; return o.n; });
s("cassign_div_tbl", function() { local o = { n = 4 }; o.n /= 2; return o.n; });
s("cassign_div_arr", function() { local o = [4]; o[0] /= 2; return o[0]; });
s("cassign_div_cls", function() { class C { n = 4; } C.n /= 2; return C.n; });
s("cassign_div_inst", function() { class C { n = 4; } local o = C(); o.n /= 2; return o.n; });
s("cassign_mod_tbl", function() { local o = { n = 4 }; o.n %= 2; return o.n; });
s("cassign_mod_arr", function() { local o = [4]; o[0] %= 2; return o[0]; });
s("cassign_mod_cls", function() { class C { n = 4; } C.n %= 2; return C.n; });
s("cassign_mod_inst", function() { class C { n = 4; } local o = C(); o.n %= 2; return o.n; });
s("post_inc_inst", function() { class C { n = 4; } local o = C(); local r = o.n++; return r + "," + o.n; });
s("pre_inc_inst", function() { class C { n = 4; } local o = C(); local r = ++o.n; return r + "," + o.n; });
s("post_inc_clsstatic", function() { class C { static n = 4; } local r = C.n++; return r + "," + C.n; });
s("post_inc_arr", function() { local a = [4]; local r = a[0]++; return r + "," + a[0]; });
s("post_inc_str", function() { local s = "a"; local r = s[0]++; return r + "," + s; });
s("post_inc_int", function() { local i = 4; local r = i++; return r + "," + i; });
s("post_inc_flt", function() { local f = 4.5; local r = f++; return r + "," + f; });
s("post_inc_bool", function() { local b = true; local r = b++; return r + "," + b; });
s("post_dec_inst", function() { class C { n = 4; } local o = C(); local r = o.n--; return r + "," + o.n; });
s("pre_dec_inst", function() { class C { n = 4; } local o = C(); local r = --o.n; return r + "," + o.n; });
s("post_dec_clsstatic", function() { class C { static n = 4; } local r = C.n--; return r + "," + C.n; });
s("post_dec_arr", function() { local a = [4]; local r = a[0]--; return r + "," + a[0]; });
s("post_dec_str", function() { local s = "a"; local r = s[0]--; return r + "," + s; });
s("post_dec_int", function() { local i = 4; local r = i--; return r + "," + i; });
s("post_dec_flt", function() { local f = 4.5; local r = f--; return r + "," + f; });
s("post_dec_bool", function() { local b = true; local r = b--; return r + "," + b; });
print("OPMATRIX-DONE\n");
