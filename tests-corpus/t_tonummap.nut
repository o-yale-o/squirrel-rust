// 自动生成：字符串 → 数字矩阵（tools/gen_tonummatrix.py）
// 观测口径：整数原样打印、浮点用 %.17g（默认格式只有约 6 位有效数字）。
// 注意 tag 用**下标**而不是字符串本身 —— 字符串里什么字符都有。
function obs(v) {
    local ty = typeof v;
    if (ty == "float") return format("%.17g", v);
    return "" + v;
}
function t(tag, f) {
    try { local v = f(); print(tag + "=" + obs(v) + "|" + typeof v + "\n"); }
    catch (e) { print(tag + "!" + e + "\n"); }
}

