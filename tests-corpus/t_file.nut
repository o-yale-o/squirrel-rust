local f = file("diff_test_data.bin", "wb+");
f.writen(0x4142, 'w');
f.writen(-100000, 'i');
f.writen(3.5, 'f');
f.writen(2.25, 'd');
f.writen(7, 'b');
f.writen(-3, 'c');
f.writen(123456789, 'l');
f.writen(-2, 's');
local blob = blob(4);
blob[0] = 0x11; blob[1] = 0x22; blob[2] = 0x33; blob[3] = 0x44;
f.writeblob(blob);
print("tell=" + f.tell() + "\n");
f.seek(0, 'b');
print("len=" + f.len() + "\n");
print("w=" + f.readn('w') + "\n");
print("i=" + f.readn('i') + "\n");
print("f=" + f.readn('f') + "\n");
print("d=" + f.readn('d') + "\n");
print("b=" + f.readn('b') + "\n");
print("c=" + f.readn('c') + "\n");
print("l=" + f.readn('l') + "\n");
print("s=" + f.readn('s') + "\n");
local rb = f.readblob(4);
print("blob.len=" + rb.len() + "\n");
print("blob[0]=" + rb[0] + " blob[3]=" + rb[3] + "\n");
print("eos=" + (f.eos() != null) + "\n");
f.close();
remove("diff_test_data.bin");
