local s1 = "tab\there";
print(s1.len() + " ");
print(s1.find("\t") + "\n");
print("\x41\x42" + "\n");
print("quote:\"q\"" + "\n");
local v = @"raw\nstring";
print(v.len() + "\n");
print(65.tochar() + 66.tochar() + "\n");
print(true + 1); print(" ");
print(false + 1); print("\n");
print(null == null); print(" ");
print(1 == 1.0); print(" ");
print(0 == false); print(" ");
print("" == null); print("\n");
print(1 <=> 2); print(" ");
print(2 <=> 1); print(" ");
print(1 <=> 1); print("\n");
local x = null;
print(x == null); print("\n");
print(typeof typeof 1 + "\n");
