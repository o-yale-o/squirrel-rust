local arr = [];
for(local i = 0; i < 20; i++) arr.append(i * i);
print(arr.len() + "\n");
arr.resize(5);
print(arr.len() + " " + arr.top() + "\n");
arr.resize(8, "f");
print(arr.len() + " " + arr[7] + "\n");
print(arr.slice(2, 5).len() + "\n");
print(arr.find("f") + "\n");
local sum = arr.reduce(function(a, b) { return typeof a == "integer" ? a + b : a; });
print(sum + "\n");
local big = [];
for(local i = 0; i < 100; i++) big.append(i);
print(big.reduce(function(a, b) { return a + b; }) + "\n");
big.sort(function(a, b) { return b <=> a; });
print(big[0] + " " + big[99] + "\n");
local nested = [[1,2],[3,4]];
foreach(sub in nested) foreach(v in sub) print(v);
print("\n");
