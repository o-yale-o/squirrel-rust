local w = file("diff_test_rw.txt", "wb+");
local b1 = blob(0);
b1.writen(72, 'b');
b1.writen(101, 'b');
b1.writen(108, 'b');
b1.writen(108, 'b');
b1.writen(111, 'b');
w.writeblob(b1);
w.flush();
w.seek(0, 'b');
local r = w.readblob(5);
local s = "";
for(local i = 0; i < r.len(); i++) s += r[i].tochar();
print(s + "\n");
w.close();
remove("diff_test_rw.txt");
print("done\n");
local b2 = blob(0);
b2.writen(0x1234, 'w');
b2.seek(0, 'b');
print(b2.readn('w') + "\n");
b2.seek(0, 'b');
b2.swap2();
b2.seek(0, 'b');
print(b2.readn('w') + "\n");
local b3 = blob(0);
b3.writen(1.5, 'f');
b3.seek(0, 'b');
print(b3.readn('f') + "\n");
print(casti2f(swap4(castf2i(2.5))) + "\n");
print(swap2(0x1234) + "\n");
print(swap4(0x12345678) + "\n");
// blob 全局函数（↔ sqstdblob.cpp 的 _g_blob_*，掩码 .n）
print(swap4(1) + "\n");
print(swap2(0xFF) + "\n");
print(castf2i(1.5) & 0xFFFFFFFF) + "\n";
print(casti2f(1069547520) + "\n");
print(swapfloat(1.0) + "\n");
print(casti2f(0x40200000) + "\n");
function tt(tag, f) { try { print(tag + "=" + f() + "\n"); } catch (e) { print(tag + "!" + e + "\n"); } }
tt("bad_casti2f", function() { return casti2f("x"); });
tt("bad_swap2", function() { return swap2(); });

// 文件流上的负绝对偏移：CRT 的 fseek(f, -1, SEEK_SET) 是**失败**（返回 -1），
// 原来我们把负偏移夹成 0 再当成功返回 —— 变异 t_writeread 时抓到的差异（见 P8）。
local wneg = file("diff_test_seekneg.txt", "wb+");
local bneg = blob(2);
bneg.writen(0x1234, 'w');
wneg.writeblob(bneg);
wneg.flush();
wneg.seek(0, 'b');
print("seekneg_ret=" + wneg.seek(-1, 'b') + "\n");
print("seekneg_tell=" + wneg.tell() + "\n");
print("seekneg_read=" + wneg.readn('w') + "\n");
print("seekneg_past_ret=" + wneg.seek(99, 'b') + "\n");
print("seekneg_past_tell=" + wneg.tell() + "\n");
print("seekneg_cur_neg=" + wneg.seek(-1, 'c') + "\n");
print("seekneg_end_neg=" + wneg.seek(-1, 'e') + "\n");
print("seekneg_end_far=" + wneg.seek(-99, 'e') + "\n");
wneg.close();
remove("diff_test_seekneg.txt");
