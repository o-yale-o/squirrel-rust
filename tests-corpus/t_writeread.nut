local w = file("diff_test_rw.txt", "wb+");
local blob = blob(0);
blob.writen(72, 'b');
blob.writen(101, 'b');
blob.writen(108, 'b');
blob.writen(108, 'b');
blob.writen(111, 'b');
w.writeblob(blob);
w.flush();
w.seek(0, 'b');
local r = w.readblob(5);
local s = "";
for(local i = 0; i < r.len(); i++) s += r[i].tochar();
print(s + "\n");
w.close();
remove("diff_test_rw.txt");
print("done\n");
local b2 = blob(0);
b2.writen(0x1234, 'w');
b2.seek(0, 'b');
print(b2.readn('w') + "\n");
b2.seek(0, 'b');
b2.swap2();
b2.seek(0, 'b');
print(b2.readn('w') + "\n");
local b3 = blob(0);
b3.writen(1.5, 'f');
b3.seek(0, 'b');
print(b3.readn('f') + "\n");
print(casti2f(swap4(castf2i(2.5))) + "\n");
print(swap2(0x1234) + "\n");
print(swap4(0x12345678) + "\n");
