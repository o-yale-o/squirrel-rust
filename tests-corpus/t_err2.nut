try { print({} + 1); } catch(e) { print(e + "\n"); }
try { print("a" - 1); } catch(e) { print(e + "\n"); }
try { print(1 / 0); } catch(e) { print(e + "\n"); }
try { print(1 % 0); } catch(e) { print(e + "\n"); }
try { print(-{}); } catch(e) { print(e + "\n"); }
try { print(~1.5); } catch(e) { print(e + "\n"); }
