s("bad_open_paren", function() { local r = rx("("); return "ok:" + r.subexpcount(); });
s("bad_close_paren", function() { local r = rx(")"); return "ok:" + r.subexpcount(); });
s("bad_open_bracket", function() { local r = rx("["); return "ok:" + r.subexpcount(); });
s("bad_empty_class", function() { local r = rx("[]"); return "ok:" + r.subexpcount(); });
s("bad_unfinished_range", function() { local r = rx("[a-"); return "ok:" + r.subexpcount(); });
s("bad_invalid_range", function() { local r = rx("[z-a]"); return "ok:" + r.subexpcount(); });
s("bad_class_in_range", function() { local r = rx("[\\d-z]"); return "ok:" + r.subexpcount(); });
s("bad_same_balanced", function() { local r = rx("\\p{aa}"); return "ok:" + r.subexpcount(); });
s("bad_bad_balanced", function() { local r = rx("\\p{a"); return "ok:" + r.subexpcount(); });
s("bad_escape_eof", function() { local r = rx("\\"); return "ok:" + r.subexpcount(); });
s("bad_bad_escape", function() { local r = rx("\\q"); return "ok:" + r.subexpcount(); });
s("bad_brace_open", function() { local r = rx("a{"); return "ok:" + r.subexpcount(); });
s("bad_brace_comma", function() { local r = rx("a{,"); return "ok:" + r.subexpcount(); });
s("bad_brace_badend", function() { local r = rx("a{2,1}"); return "ok:" + r.subexpcount(); });
s("bad_brace_overflow", function() { local r = rx("a{1000000000}"); return "ok:" + r.subexpcount(); });
s("bad_bad_group_prefix", function() { local r = rx("(?<a>"); return "ok:" + r.subexpcount(); });
s("bad_unexpected_char", function() { local r = rx("(?a)"); return "ok:" + r.subexpcount(); });

// ---- 3. API 边界：start 偏移、类型、constructor 重用、typeof/tostring
s("api_subexpcount0", function() { return regexp("abc").subexpcount(); });
s("api_subexpcount3", function() { return regexp("(a)(b(c))?").subexpcount(); });
s("api_subexpcount_noncap", function() { return regexp("(?:a)(b)").subexpcount(); });
s("api_typeof", function() { return typeof regexp("a"); });
s("api_tostring", function() { local r = regexp("a"); try { return r.tostring(); } catch (e) { return "E:" + e; } });
s("api_reconstruct", function() { local r = regexp("a"); try { return "" + r.constructor("b"); } catch (e) { return "E:" + e; } });
s("api_classof", function() { return regexp("a").getclass(); });
s("api_search_nonstr_subject", function() { try { return "" + regexp("a").search(5); } catch (e) { return "E:" + e; } });
s("api_search_null_subject", function() { try { return "" + regexp("a").search(null); } catch (e) { return "E:" + e; } });
s("api_search_badstart_type", function() { try { return "" + regexp("a").search("abc", null); } catch (e) { return "E:" + e; } });
s("api_search_strstart", function() { try { return "" + regexp("a").search("abc", "1"); } catch (e) { return "E:" + e; } });
s("api_search_floatstart", function() { return d(regexp("a").search("aaa", 1.7)); });
s("api_match_nonstr", function() { try { return "" + regexp("a").match(1); } catch (e) { return "E:" + e; } });
s("api_match_extra_args", function() { try { return "" + regexp("a").match("a", 0); } catch (e) { return "E:" + e; } });
s("api_capture_nonstr", function() { try { return "" + regexp("a").capture(1); } catch (e) { return "E:" + e; } });
s("api_search_notable", function() { local r = regexp("z"); return typeof r.search("abc"); });
s("api_capture_notable", function() { local r = regexp("z"); return typeof r.capture("abc"); });
s("api_match_nomatch", function() { return regexp("z").match("abc"); });
s("api_two_instances", function() { local a = regexp("a"); local b = regexp("b"); return d(a.search("ab")) + "/" + d(b.search("ab")); });
s("api_ctor_wrong_type", function() { try { return "" + regexp(5); } catch (e) { return "E:" + e; } });
s("api_ctor_null", function() { try { return "" + regexp(null); } catch (e) { return "E:" + e; } });

// ---- 4. start 偏移（0..len；越界区间在参考实现里是 UB，已排除）
s("off_abc_0", function() { return d(regexp("a").search("abc", 0)) + "/" + d(regexp("a").capture("abc", 0)); });
