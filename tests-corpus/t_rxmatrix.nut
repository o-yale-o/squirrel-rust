// ---- 5. 引擎细节：量词贪婪/非贪婪、嵌套分组、回溯、大小写、高位字节
s("det_greedy_vs_lazy", function() { return d(regexp("<.*>").search("<a><b>")) + "/" + d(regexp("<.*?>").search("<a><b>")); });
s("det_backtrack", function() { return d(regexp("a*a*b").search("aaab")) + "/" + d(regexp("(a+)+b").search("aaab")); });
s("det_group_repeat_capture", function() { return d(regexp("(a)+").capture("aaa")); });
s("det_nested_optional", function() { return d(regexp("(a(b)?c)").capture("ac")) + "/" + d(regexp("(a(b)?c)").capture("abc")); });
s("det_case_sensitive", function() { return d(regexp("abc").search("ABC")); });
s("det_dot_no_newline", function() { return d(regexp("a.b").search("a\nb")) + "/" + d(regexp("(?s)a.b").search("a\nb")); });
s("det_high_byte_class", function() { return d(regexp("[\xe9]").search("\xe9")); });
s("det_high_byte_dot", function() { return d(regexp("a.c").search("a\xe9c")); });
s("det_anchor_after_start", function() { return d(regexp("^b").search("ab", 1)); });
s("det_eol_with_start", function() { return d(regexp("a$").search("aba", 0)); });
s("det_empty_match", function() { return d(regexp("a*").search("bbb")); });
s("det_empty_pattern_group", function() { return d(regexp("()").capture("x")); });
s("det_alternation_order", function() { return d(regexp("a|ab").search("ab")) + "/" + d(regexp("ab|a").search("ab")); });
s("det_brace_exact_fail", function() { return d(regexp("a{3}").search("aa")); });
s("det_cclass_neg_digit", function() { return d(regexp("\\D+").search("12ab34")); });
s("det_wb_edges", function() { return d(regexp("\\bfoo").search("xfoo")) + "/" + d(regexp("foo\\b").search("foox")); });
s("det_cclassexpr_neg", function() { return d(regexp("[[:^digit:]]+").search("12ab")); });
s("det_ccclass_upper", function() { return d(regexp("[[:upper:]]+").search("aBCd")); });
s("det_space_class_exact", function() { return d(regexp("[ \\t]+").search("a \tb")); });

print("RXMATRIX-DONE\n");
