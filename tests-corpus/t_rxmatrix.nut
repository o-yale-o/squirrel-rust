// 自动生成：python tools/gen_rxmatrix.py —— 请勿手改
// 正则语义组合矩阵（↔ sqstdlib/sqstdrex.cpp 引擎 + sqstdstring.cpp 的 rexobj 方法）

function s(tag, f) {
    try { print(tag + "=" + f() + "\n"); }
    catch (e) { print(tag + "!" + e + "\n"); }
}
function rx(p) { return regexp(p); }
// 结构化描述：{b,e} 表 / [{b,e},…] 数组 / 裸值
function d(x) {
    local t = typeof x;
    if (t == "table") return "{" + x.begin + "," + x.end + "}";
    if (t == "array") {
        local o = "[";
        for (local i = 0; i < x.len(); i++) {
            if (i > 0) o += ",";
            o += "{" + x[i].begin + "," + x[i].end + "}";
        }
        return o + "]";
    }
    return "" + x;
}
// 一个模式对一个主语：search / capture / subexpcount / match 四件套
function probe(p, subj) {
    local r = rx(p);
    local out = "N" + r.subexpcount();
    out += " S" + d(r.search(subj));
    out += " C" + d(r.capture(subj));
    out += " M" + r.match(subj);
    return out;
}

