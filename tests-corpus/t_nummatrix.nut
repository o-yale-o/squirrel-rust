// ---- 5. 自增、复合赋值、就地运算（边界溢出）
s("inc_max", function() { local x = 9223372036854775807; x++; return d(x); });
s("dec_max", function() { local x = 9223372036854775807; x--; return d(x); });
s("ca_max_+", function() { local x = 9223372036854775807; try { x += 2; } catch (e) { return "E:" + e; } return d(x); });
s("ca_max_-", function() { local x = 9223372036854775807; try { x -= 2; } catch (e) { return "E:" + e; } return d(x); });
