// ---- 9. 数值字面量的解析（词法面，P1-3 会继续扩）
s("lit_dec0", function() { local v = 0; return typeof v + ":" + d(v); });
s("lit_dec00", function() { local v = 00; return typeof v + ":" + d(v); });
s("lit_hex", function() { local v = 0x1F; return typeof v + ":" + d(v); });
s("lit_hexcap", function() { local v = 0xFF; return typeof v + ":" + d(v); });
s("lit_hex0", function() { local v = 0x0; return typeof v + ":" + d(v); });
s("lit_neghex", function() { local v = -0x10; return typeof v + ":" + d(v); });
s("lit_fdot", function() { local v = 1.; return typeof v + ":" + d(v); });
s("lit_fexp", function() { local v = 1e3; return typeof v + ":" + d(v); });
s("lit_fexpc", function() { local v = 1E3; return typeof v + ":" + d(v); });
s("lit_fexpneg", function() { local v = 1e-3; return typeof v + ":" + d(v); });
s("lit_fexpplus", function() { local v = 1e+3; return typeof v + ":" + d(v); });
s("lit_f_exp_f", function() { local v = 1.5e3; return typeof v + ":" + d(v); });
